# Copy this file to .env and replace every change-me value.
POSTGRES_PASSWORD=generate-on-first-start-postgres
AIRFLOW_FERNET_KEY=generate-on-first-start-fernet
AIRFLOW_JWT_SECRET=generate-on-first-start-jwt
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-password
AIRFLOW_PORT=8080

# Snowflake connection used by dbt.
SNOWFLAKE_ACCOUNT=change-me
SNOWFLAKE_USER=change-me
SNOWFLAKE_PASSWORD=change-me
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=FINANCE_DB
SNOWFLAKE_WAREHOUSE=TRANSFORMING_WH
SNOWFLAKE_SCHEMA=RAW
